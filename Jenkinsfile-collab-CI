pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build & Test Collaboration Room') {
            steps {
                dir('backend-integre/Collaboration-Room-Microservice') {
                    sh 'chmod +x mvnw && ./mvnw -B clean package -DskipTests'
                }
            }
        }

        stage('Docker Build Collaboration Room') {
            steps {
                sh 'docker build -t jungle/collaboration-room:ci backend-integre/Collaboration-Room-Microservice'
            }
        }

        stage('Security Scan - Trivy') {
            steps {
                sh '/usr/local/bin/trivy image --exit-code 0 --severity HIGH,CRITICAL --format template --template "@contrib/html.tpl" --output /tmp/trivy-report-collab.html --timeout 15m jungle/collaboration-room:ci || true'
                sh 'cp /tmp/trivy-report-collab.html $WORKSPACE/trivy-report-collab.html || true'
                sh '/usr/local/bin/trivy image --exit-code 0 --severity HIGH,CRITICAL --format table --timeout 15m jungle/collaboration-room:ci'
            }
        }
    }

    post {
        success {
            echo 'CI Collaboration Room réussi ✅'
            build job: 'collaboration-CD', wait: false
        }
        failure {
            echo 'CI Collaboration Room échoué ❌'
        }
    }
}